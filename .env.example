# URL of the app-concursos-backend API (must be reachable from the browser).
NEXT_PUBLIC_API_URL=http://localhost:8001

# Public site URL used for canonical metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://estuda.app

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console site verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Feature flag for showing app download buttons on the site.
NEXT_PUBLIC_ENABLE_APP_DOWNLOAD_LINKS=false

# Store URLs (kept disabled until the real links are available).
NEXT_PUBLIC_APPLE_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# "false" shows the full site (pricing, checkout). Anything else: pre-launch
# page plus the legal pages only. Build-time: redeploy after changing it.
NEXT_PUBLIC_PRELAUNCH=true
